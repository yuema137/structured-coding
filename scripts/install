#!/usr/bin/env python3
"""Install the standalone skill into an explicitly selected project."""

import argparse
import os
import subprocess
import sys
import tempfile
from pathlib import Path

from build_packages import source_files


PLATFORMS = {
    "codex": (".agents", "$structured-coding"),
    "claude-code": (".claude", "/structured-coding"),
}


def install(host, project, dry_run=False):
    """Copy publishable files without replacing an existing installation."""
    project = Path(project).expanduser().resolve(strict=True)
    if not project.is_dir():
        raise ValueError(f"Project is not a directory: {project}")

    config, _ = PLATFORMS[host]
    parent = project / config / "skills"
    for path in (project / config, parent):
        if path.is_symlink():
            raise ValueError(f"Refusing redirected installation directory: {path}")
        if path.exists() and not path.is_dir():
            raise ValueError(f"Installation parent is not a directory: {path}")
    destination = parent / "structured-coding"
    if os.path.lexists(destination):
        raise FileExistsError(f"Already exists: {destination}. Compare or back up your installation before updating.")

    # Reuse the package allowlist; private authoring files never enter the copy.
    # Read everything before changing the project so missing sources fail early.
    payload = {relative: path.read_bytes() for relative, path in source_files(host).items()}
    if dry_run:
        return destination
    parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".structured-coding-install-", dir=parent) as temporary:
        staged = Path(temporary) / "structured-coding"
        for relative, content in payload.items():
            target = staged / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(content)

        # Reserve the name without overwriting even an empty existing directory.
        # Publishing the complete staged directory is atomic on macOS/Linux.
        destination.mkdir()
        try:
            os.replace(staged, destination)
        except OSError:
            # Only remove our empty reservation, never a populated directory.
            try:
                destination.rmdir()
            except OSError:
                pass
            raise
    return destination


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("host", choices=PLATFORMS)
    parser.add_argument("--project", required=True, type=Path,
                        help="Existing target project directory (use . for the current directory)")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--hooks", nargs="+", action="append", choices=("continuity", "checkpoints"),
                       help="Add the selected project-local hook presets")
    modes.add_argument("--remove-hooks", nargs="*", action="append", choices=("continuity", "checkpoints"),
                       help="Remove selected presets, or all owned presets when no names are given")
    modes.add_argument("--check-hooks", action="store_true", help="Check registration, runtime files, and host version")
    parser.add_argument("--dry-run", action="store_true", help="Preview installation/removal without writing")
    args = parser.parse_args()
    for name in ("hooks", "remove_hooks"):
        occurrences = getattr(args, name)
        values = None if occurrences is None else [value for group in occurrences for value in group]
        setattr(args, name, values)
        if values and len(values) != len(set(values)):
            parser.error(f"--{name.replace('_', '-')}: duplicate preset selection")
    try:
        if args.hooks or args.remove_hooks is not None or args.check_hooks:
            import hook_install
            if args.remove_hooks is not None:
                path = hook_install.remove(args.host, args.project, args.dry_run,
                                           presets=args.remove_hooks or None)
                selected = ", ".join(args.remove_hooks) if args.remove_hooks else "all owned presets"
                print(f"{'Would remove' if args.dry_run else 'Removed'} {selected}: {path}")
                print("Skill files, session bindings, and checkpoints are retained. Existing settings are preserved/restored.")
                return 0
            if args.check_hooks:
                print(hook_install.doctor(args.host, args.project))
                return 0
            if not args.dry_run:
                hook_install.recover(args.host, args.project)
            plan = hook_install.prepare(args.host, args.project, args.hooks)
            selected = ", ".join(plan["presets"])
            if plan["skill"].exists():
                hook_install.verify_skill(plan)
            if args.dry_run:
                if not plan["skill"].exists():
                    install(args.host, args.project, dry_run=True)
                print(f"Would install/reuse skill at {plan['skill']}")
                print(f"Would register/reuse {selected}: {plan['config']} ({args.host} {plan['version']})")
                print("Events: " + ", ".join(plan["groups"]) + ".")
                print("Existing hooks/settings preserved. No global settings, trust, or permission changes.")
                return 0
            if not plan["skill"].exists():
                install(args.host, args.project)
            hook_install.apply(plan)
            print(f"Hook presets registered ({selected}) in {plan['config']}. Skill: {plan['skill']}")
            print("Restart the host and review/enable the hooks through /hooks; trust is not granted by this installer.")
            print("Only explicit session bindings are checked. Read each selected references/<preset>.md in the installed skill.")
            print("No merge guard, mutation guard, global settings, or permission changes.")
            return 0
        if args.dry_run:
            destination = install(args.host, args.project, dry_run=True)
            print(f"Would copy skill files to {destination}; no hooks.")
            return 0
        destination = install(args.host, args.project)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"Installation failed: {error}", file=sys.stderr)
        return 1
    print(f"Installed structured-coding for {args.host}: {destination}")
    print(f"Open the target project in your agent and invoke {PLATFORMS[args.host][1]}.")
    print("Copied skill files only. No hooks were registered; global settings and permissions were unchanged.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
